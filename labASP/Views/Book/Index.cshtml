@model List<Book>
@{
    ViewData["Title"] = "Lista książek";
}
@section Styles {
    <style>
        .table thead th {
            background-color: #f8f8f8;
            border-bottom: 2px solid blue;
        }
    </style>
}
<h2>Książki</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Dodaj książkę</a>
<table class="table">
    <thead><tr><th>Tytuł</th><th>Autor</th><th>Rok</th><th>Cena</th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <partial name="_BookRow" model="b" />
    }
    </tbody>
</table>